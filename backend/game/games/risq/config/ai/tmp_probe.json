{"rules":[{"when":{"always":{}},"then":[{"action":"for_each","select":{"kind":"zones"},"as":"z","do":[{"action":"set_var","name":"p","value":"var(z.space.build_speed_modifier)"},{"action":"set_var","name":"a","value":{"max":{"kind":"spaces","where":{"if":"distance(z, item) == 0"},"of":"var(item.build_speed_modifier)"}}},{"action":"set_var","name":"mm","value":"var(mm) + max(0, var(p) - var(a)) + max(0, var(a) - var(p))"},{"action":"set_var","name":"zn","value":"var(zn) + 1"},{"action":"set_var","name":"bx","value":"max(var(bx), (var(p) != var(a)) * (var(z.x) + 1000))"},{"action":"set_var","name":"by","value":"max(var(by), (var(p) != var(a)) * (var(z.y) + 1000))"},{"action":"set_var","name":"ba","value":"max(var(ba), (var(p) != var(a)) * var(a))"},{"action":"set_var","name":"bp","value":"max(var(bp), (var(p) != var(a)) * var(p))"}]}]}]}
