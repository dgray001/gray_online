{
  "rules": [
    {"when":{"always":{}},"then":[
      {"action":"set_var","name":"unexplored","value":{"count":{"kind":"spaces","where":{"vision":0}}}},
      {"action":"select","pick":{"kind":"units","where":{"unit_types":["military"],"if":{"count":{"kind":"spaces","where":{"vision_at_most":1}}}},"rank":"0 - var(target.uid)","limit":1},"into":{"set":"explorer"}},
      {"action":"select","actors":{"kind":"units","where":{"in_set":"explorer"}},"pick":{"kind":"spaces","where":{"vision_at_most":1,"if":"(var(unexplored) == 0) + (var(target.vision) == 0)"}},"match":{"score":["(var(unexplored) == 0) * var(target.turns_since_seen)","0 - distance(actor, target)","0 - var(target.x)","0 - var(target.y)"]},"issue":[{"move":{"to":"zone"}}]},
      {"action":"set_var","name":"enemies","value":{"count":{"kind":"attackables"}}},
      {"action":"select","actors":{"kind":"units","where":{"unit_types":["military"],"not_in_set":"explorer","if":"var(actor.idle)"}},"pick":{"kind":"attackables"},"match":{"score":["0 - var(target.is_building)","0 - distance(actor, target, 1)","0 - var(target.uid)"]},"issue":[{"attack":{}}]},
      {"action":"select","actors":{"kind":"units","where":{"unit_types":["military"],"not_in_set":"explorer","if":"var(actor.idle) * (var(enemies) == 0)"}},"pick":{"kind":"spaces","where":{"owner":"enemy"}},"match":{"score":["0 - distance(actor, target)","0 - var(target.x)","0 - var(target.y)"]},"issue":[{"attack":{"to":"space"}}]}
    ]},
    {"when":{"always":{}},"then":[
      {"action":"select","actors":{"kind":"units","where":{"unit_types":["economic"],"in":{"order_kind":["gather","none"]}}},"pick":{"kind":"foundations","where":{"if":"var(target.builders) == 0"},"capacity":1},"match":{"score":["0 - distance(actor, target, 1)","0 - var(target.x)","0 - var(target.y)","0 - var(target.zone_x)","0 - var(target.zone_y)"]},"issue":[{"build":{}}]}
    ]},
    {"when":{"all":[{"value_at_most":{"value":"gameVar(population_limit) - gameVar(population)","amount":2}},{"value_equals":{"value":{"count":{"kind":"foundations","where":{"building_ids":[2]}}},"amount":0}}]},"then":[
      {"action":"select","actors":{"kind":"units","where":{"can_build":2,"in":{"order_kind":["gather","none"]},"if":"gameVar(wood) >= 30"},"rank":"0 - var(actor.uid)","limit":1},"pick":{"kind":"zones","where":{"resource":false,"building":false}},"match":{"score":["0 - distance(actor, target, 1)","0 - var(target.x)","0 - var(target.y)","0 - var(target.zone_x)","0 - var(target.zone_y)"]},"issue":[{"build":{"building_id":2}}]}
    ]},
    {"when":{"always":{}},"then":[
      {"action":"for_each","select":{"kind":"buildings","where":{"can_research":1}},"as":"b","do":[{"action":"select","actors":{"kind":"buildings","where":{"can_research":1,"if":"(var(actor.uid) == var(b.uid)) * var(actor.idle) * (gameVar(food) >= 50) * (gameVar(wood) >= 50)"}},"issue":[{"research":{"tech_id":1}}]}]},
      {"action":"for_each","select":{"kind":"buildings","where":{"can_research":2}},"as":"b","do":[{"action":"select","actors":{"kind":"buildings","where":{"can_research":2,"if":"(var(actor.uid) == var(b.uid)) * var(actor.idle) * (gameVar(stone) >= 100) * (gameVar(gold) >= 100)"}},"issue":[{"research":{"tech_id":2}}]}]},
      {"action":"for_each","select":{"kind":"buildings","where":{"can_research":3}},"as":"b","do":[{"action":"select","actors":{"kind":"buildings","where":{"can_research":3,"if":"(var(actor.uid) == var(b.uid)) * var(actor.idle) * (gameVar(stone) >= 100) * (gameVar(gold) >= 100)"}},"issue":[{"research":{"tech_id":3}}]}]},
      {"action":"for_each","select":{"kind":"buildings","where":{"can_research":5}},"as":"b","do":[{"action":"select","actors":{"kind":"buildings","where":{"can_research":5,"if":"(var(actor.uid) == var(b.uid)) * var(actor.idle) * (gameVar(wood) >= 100) * (gameVar(gold) >= 100)"}},"issue":[{"research":{"tech_id":5}}]}]},
      {"action":"for_each","select":{"kind":"buildings","where":{"can_research":4}},"as":"b","do":[{"action":"select","actors":{"kind":"buildings","where":{"can_research":4,"if":"(var(actor.uid) == var(b.uid)) * var(actor.idle) * (gameVar(wood) >= 150)"}},"issue":[{"research":{"tech_id":4}}]}]}
    ]},
    {"when":{"always":{}},"then":[
      {"action":"for_each","select":{"kind":"buildings","where":{"can_create":1}},"as":"b","do":[{"action":"select","actors":{"kind":"buildings","where":{"can_create":1,"if":"(var(actor.uid) == var(b.uid)) * var(actor.idle) * (gameVar(food) >= 50) * (gameVar(population) < gameVar(population_limit))"}},"issue":[{"create":{"unit_id":1}}]}]},
      {"action":"for_each","select":{"kind":"buildings","where":{"can_create":101}},"as":"b","do":[{"action":"select","actors":{"kind":"buildings","where":{"can_create":101,"if":"(var(actor.uid) == var(b.uid)) * var(actor.idle) * (gameVar(food) >= 50) * (gameVar(wood) >= 20) * (gameVar(population) < gameVar(population_limit))"}},"issue":[{"create":{"unit_id":101}}]}]},
      {"action":"for_each","select":{"kind":"buildings","where":{"can_create":102}},"as":"b","do":[{"action":"select","actors":{"kind":"buildings","where":{"can_create":102,"if":"(var(actor.uid) == var(b.uid)) * var(actor.idle) * (gameVar(food) >= 70) * (gameVar(wood) >= 40) * (gameVar(population) < gameVar(population_limit))"}},"issue":[{"create":{"unit_id":102}}]}]},
      {"action":"for_each","select":{"kind":"buildings","where":{"can_create":103}},"as":"b","do":[{"action":"select","actors":{"kind":"buildings","where":{"can_create":103,"if":"(var(actor.uid) == var(b.uid)) * var(actor.idle) * (gameVar(food) >= 120) * (gameVar(gold) >= 70) * (gameVar(population) < gameVar(population_limit))"}},"issue":[{"create":{"unit_id":103}}]}]},
      {"action":"for_each","select":{"kind":"buildings","where":{"can_create":401}},"as":"b","do":[{"action":"select","actors":{"kind":"buildings","where":{"can_create":401,"if":"(var(actor.uid) == var(b.uid)) * var(actor.idle) * (gameVar(wood) >= 90) * (gameVar(stone) >= 40) * (gameVar(population) < gameVar(population_limit))"}},"issue":[{"create":{"unit_id":401}}]}]}
    ]},
    {"when":{"all":[{"value_at_most":{"value":{"count":{"kind":"buildings","where":{"building_ids":[1]}}},"amount":0}},{"value_equals":{"value":{"count":{"kind":"foundations","where":{"building_ids":[1]}}},"amount":0}}]},"then":[
      {"action":"select","actors":{"kind":"units","where":{"can_build":1,"in":{"order_kind":["gather","none"]},"if":"(gameVar(wood) >= 300) * (gameVar(stone) >= 100)"},"rank":"0 - var(actor.uid)","limit":1},"pick":{"kind":"zones","where":{"resource":false,"building":false}},"match":{"score":["0 - distance(actor, target, 1)","0 - var(target.x)","0 - var(target.y)","0 - var(target.zone_x)","0 - var(target.zone_y)"]},"issue":[{"build":{"building_id":1}}]}
    ]},
    {"when":{"all":[{"value_at_most":{"value":{"count":{"kind":"buildings","where":{"building_ids":[22]}}},"amount":3}},{"value_equals":{"value":{"count":{"kind":"foundations","where":{"building_ids":[22]}}},"amount":0}}]},"then":[
      {"action":"select","actors":{"kind":"units","where":{"can_build":22,"in":{"order_kind":["gather","none"]},"if":"(gameVar(wood) >= 150) * (gameVar(stone) >= 50)"},"rank":"0 - var(actor.uid)","limit":1},"pick":{"kind":"zones","where":{"resource":false,"building":false}},"match":{"score":["0 - distance(actor, target, 1)","0 - var(target.x)","0 - var(target.y)","0 - var(target.zone_x)","0 - var(target.zone_y)"]},"issue":[{"build":{"building_id":22}}]}
    ]},
    {"when":{"all":[{"value_at_most":{"value":{"count":{"kind":"buildings","where":{"building_ids":[11]}}},"amount":1}},{"value_equals":{"value":{"count":{"kind":"foundations","where":{"building_ids":[11]}}},"amount":0}}]},"then":[
      {"action":"select","actors":{"kind":"units","where":{"can_build":11,"in":{"order_kind":["gather","none"]},"if":"(gameVar(wood) >= 100) * (gameVar(stone) >= 100)"},"rank":"0 - var(actor.uid)","limit":1},"pick":{"kind":"zones","where":{"resource":false,"building":false}},"match":{"score":["0 - distance(actor, target, 1)","0 - var(target.x)","0 - var(target.y)","0 - var(target.zone_x)","0 - var(target.zone_y)"]},"issue":[{"build":{"building_id":11}}]}
    ]},
    {"when":{"all":[{"value_at_most":{"value":{"count":{"kind":"buildings","where":{"building_ids":[23]}}},"amount":3}},{"value_equals":{"value":{"count":{"kind":"foundations","where":{"building_ids":[23]}}},"amount":0}}]},"then":[
      {"action":"select","actors":{"kind":"units","where":{"can_build":23,"in":{"order_kind":["gather","none"]},"if":"(gameVar(wood) >= 250) * (gameVar(stone) >= 250)"},"rank":"0 - var(actor.uid)","limit":1},"pick":{"kind":"zones","where":{"resource":false,"building":false}},"match":{"score":["0 - distance(actor, target, 1)","0 - var(target.x)","0 - var(target.y)","0 - var(target.zone_x)","0 - var(target.zone_y)"]},"issue":[{"build":{"building_id":23}}]}
    ]},
    {"when":{"all":[{"value_at_most":{"value":{"count":{"kind":"buildings","where":{"building_ids":[21]}}},"amount":3}},{"value_equals":{"value":{"count":{"kind":"foundations","where":{"building_ids":[21]}}},"amount":0}}]},"then":[
      {"action":"select","actors":{"kind":"units","where":{"can_build":21,"in":{"order_kind":["gather","none"]},"if":"(gameVar(wood) >= 25) * (gameVar(stone) >= 5)"},"rank":"0 - var(actor.uid)","limit":1},"pick":{"kind":"zones","where":{"resource":false,"building":false}},"match":{"score":["0 - distance(actor, target, 1)","0 - var(target.x)","0 - var(target.y)","0 - var(target.zone_x)","0 - var(target.zone_y)"]},"issue":[{"build":{"building_id":21}}]}
    ]},
    {"when":{"always":{}},"then":[
      {"action":"set_var","name":"food_workers","value":0},
      {"action":"set_var","name":"wood_workers","value":0},
      {"action":"set_var","name":"stone_workers","value":0},
      {"action":"for_each","select":{"kind":"units","where":{"unit_types":["economic"],"in":{"order_kind":["gather","none"]}},"rank":"0 - var(worker.uid)"},"as":"worker","do":[
        {"action":"set_var","name":"category","value":"(var(wood_workers) / 4 < var(food_workers) / 4) * (var(wood_workers) / 4 <= var(stone_workers) / 2) + 2 * (var(stone_workers) / 2 < var(food_workers) / 4) * (var(stone_workers) / 2 < var(wood_workers) / 4)"},
        {"action":"select","actors":{"kind":"units","where":{"if":"var(actor.uid) == var(worker.uid)"}},"pick":{"kind":"resources","where":{"if":"var(target.category) == var(category)"},"let":{"workers":{"count":{"kind":"units","where":{"in":{"order_kind":["gather"]},"if":"(var(item.uid) != var(worker.uid)) * (var(item.order_target_uid) == var(target.uid))"}}}}},"match":{"where":{"if":"var(target.gather_capacity) > var(target.workers)"},"score":["0 - distance(actor, target, 1)","0 - var(target.uid)"]},"issue":[{"gather":{}}]},
        {"action":"set_var","name":"food_workers","value":"var(food_workers) + (var(category) == 0)"},
        {"action":"set_var","name":"wood_workers","value":"var(wood_workers) + (var(category) == 1)"},
        {"action":"set_var","name":"stone_workers","value":"var(stone_workers) + (var(category) == 2)"}
      ]}
    ]}
  ]
}
