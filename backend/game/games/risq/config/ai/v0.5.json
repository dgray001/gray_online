{
  "rules": [
    {"when":{"always":{}},"then":[
      {"action":"set_var","name":"villagers","value":{"count":{"kind":"units","where":{"unit_ids":[1]}}}},
      {"action":"set_var","name":"barracks","value":{"count":{"kind":"buildings","where":{"building_ids":[22]}}}},
      {"action":"set_var","name":"redoubts","value":{"count":{"kind":"buildings","where":{"building_ids":[23]}}}},
      {"action":"set_var","name":"smiths","value":{"count":{"kind":"buildings","where":{"building_ids":[11]}}}},
      {"action":"set_var","name":"unexplored","value":{"count":{"kind":"spaces","where":{"vision":0}}}},
      {"action":"set_var","name":"foggy","value":{"count":{"kind":"spaces","where":{"vision_at_most":1}}}},
      {"action":"select","pick":{"kind":"units","where":{"unit_types":["military"],"if":"var(foggy)"},"rank":"0 - var(target.uid)","limit":1},"into":{"set":"explorer"}},
      {"action":"select","actors":{"kind":"units","where":{"in_set":"explorer"}},"pick":{"kind":"spaces","where":{"vision_at_most":1,"if":"(var(unexplored) == 0) + (var(target.vision) == 0)"}},"match":{"score":["(var(unexplored) == 0) * var(target.turns_since_seen)","0 - distance(actor, target)","0 - var(target.x)","0 - var(target.y)"]},"issue":[{"move":{"to":"zone"}}]},
      {"action":"set_var","name":"enemies","value":{"count":{"kind":"attackables"}}},
      {"action":"set_var","name":"base_threat","value":{"count":{"kind":"units","where":{"owner":"enemy","unit_types":["military"],"near":{"distance":0,"of":{"kind":"buildings","where":{"building_ids":[1]}}}}}}},
      {"action":"if","when":{"value_at_most":{"value":{"count":{"kind":"units","where":{"bucket":"army_wave"}}},"amount":10}},"then":[{"action":"select","pick":{"kind":"units","where":{"bucket":"army_wave"}},"into":{"bucket":"army_wave","mode":"remove"}}]},
      {"action":"set_var","name":"claimers","value":{"count":{"kind":"units","where":{"bucket":"claim"}}}},
      {"action":"if","when":{"all":[{"value_at_most":{"value":"var(claimers)","amount":6}},{"value_equals":{"value":"var(base_threat)","amount":0}}]},"then":[{"action":"select","pick":{"kind":"units","where":{"unit_types":["military"],"not_in_set":"explorer","bucket":"none","near":{"distance":1,"of":{"kind":"buildings","where":{"building_ids":[1]}}}},"rank":"var(target.uid)","limit":1},"into":{"bucket":"claim","mode":"add"}}]},
      {"action":"select","actors":{"kind":"units","where":{"bucket":"claim","in":{"order_kind":["none"]}}},"pick":{"kind":"spaces","where":{"owner":"unowned","passable":true},"let":{"claiming":{"count":{"kind":"units","where":{"bucket":"claim","if":"(var(item.order_space_x) == var(target.x)) * (var(item.order_space_y) == var(target.y))"}}}},"capacity":"1 - var(target.claiming)"},"match":{"score":["0 - distance(actor, target)","0 - var(target.x)","0 - var(target.y)"]},"issue":[{"move":{"to":"space"}}]},
      {"action":"select","pick":{"kind":"units","where":{"unit_types":["military"],"not_in_set":"explorer","bucket":"none","near":{"distance":1,"of":{"kind":"buildings","where":{"building_ids":[1]}}}}},"into":{"set":"army_ready","var":"army_ready_count"}},
      {"action":"if","when":{"all":[{"value_at_least":{"value":"var(army_ready_count)","amount":36}},{"value_equals":{"value":"var(base_threat)","amount":0}}]},"then":[{"action":"select","pick":{"kind":"units","where":{"in_set":"army_ready"}},"into":{"bucket":"army_wave","mode":"add"}}]},
      {"action":"select","actors":{"kind":"units","where":{"unit_types":["military"],"not_in_set":"explorer","if":"var(base_threat) > 0"}},"pick":{"kind":"units","where":{"owner":"enemy","unit_types":["military"],"near":{"distance":0,"of":{"kind":"buildings","where":{"building_ids":[1]}}}}},"match":{"score":["0 - distance(actor, target, 1)","0 - var(target.uid)"]},"issue":[{"attack":{}}]},
      {"action":"select","actors":{"kind":"units","where":{"unit_types":["military"],"not_in_set":"explorer","bucket":"none","if":"var(base_threat) == 0"}},"pick":{"kind":"buildings","where":{"building_ids":[1]}},"match":{"score":["0 - distance(actor, target, 1)","0 - var(target.uid)"]},"issue":[{"move":{"to":"space"}}]},
      {"action":"select","pick":{"kind":"units","where":{"bucket":"army_wave","not_in_set":"explorer"},"rank":"0 - var(target.uid)","limit":1},"into":{"set":"army_leader"}},
      {"action":"select","pick":{"kind":"attackables","where":{},"let":{"army_distance":{"min":{"kind":"units","where":{"in_set":"army_leader"},"of":"distance(item, target, 1)","default":100000}}},"rank":["(1 - var(target.is_military)) * (1 - var(target.is_building))","var(target.is_military)","0 - var(target.army_distance)","0 - var(target.uid)"],"limit":1},"into":{"set":"army_target"}},
      {"action":"select","pick":{"kind":"spaces","where":{"owner":"enemy"},"let":{"army_distance":{"min":{"kind":"units","where":{"in_set":"army_leader"},"of":"distance(item, target, 1)","default":100000}}},"rank":["0 - var(target.army_distance)","0 - var(target.x)","0 - var(target.y)"],"limit":1},"into":{"set":"army_space"}},
      {"action":"select","actors":{"kind":"units","where":{"unit_types":["military"],"not_in_set":"explorer","bucket":"army_wave","if":"var(base_threat) == 0"}},"pick":{"kind":"attackables","where":{"in_set":"army_target"}},"match":{"score":["(1 - var(target.is_military)) * (1 - var(target.is_building))","var(target.is_military)","0 - distance(actor, target, 1)","0 - var(target.uid)"]},"issue":[{"attack":{}}]},
      {"action":"select","actors":{"kind":"units","where":{"unit_types":["military"],"not_in_set":"explorer","bucket":"army_wave","if":"(var(enemies) == 0) * (var(base_threat) == 0)"}},"pick":{"kind":"spaces","where":{"owner":"enemy","in_set":"army_space"}},"match":{"score":["0 - distance(actor, target)","0 - var(target.x)","0 - var(target.y)"]},"issue":[{"attack":{"to":"space"}}]}
    ]},
    {"when":{"always":{}},"then":[
      {"action":"select","actors":{"kind":"units","where":{"unit_types":["economic"],"in":{"order_kind":["gather","none"]}}},"pick":{"kind":"foundations","where":{"if":"var(target.builders) == 0"},"capacity":1},"match":{"score":["0 - distance(actor, target, 1)","0 - var(target.x)","0 - var(target.y)","0 - var(target.zone_x)","0 - var(target.zone_y)"]},"issue":[{"build":{}}]}
    ]},
    {"when":{"all":[{"value_at_most":{"value":"gameVar(population_limit) - gameVar(population)","amount":2}},{"value_equals":{"value":{"count":{"kind":"foundations","where":{"building_ids":[2]}}},"amount":0}}]},"then":[
      {"action":"select","actors":{"kind":"units","where":{"can_build":2,"in":{"order_kind":["gather","none"]},"if":"gameVar(wood) >= 30"},"rank":"0 - var(actor.uid)","limit":1},"pick":{"kind":"zones","where":{"resource":false,"building":false}},"match":{"score":["0 - distance(actor, target, 1)","0 - var(target.x)","0 - var(target.y)","0 - var(target.zone_x)","0 - var(target.zone_y)"]},"issue":[{"build":{"building_id":2}}]}
    ]},
    {"when":{"always":{}},"then":[
      {"action":"for_each","select":{"kind":"buildings","where":{"can_research":1}},"as":"b","do":[{"action":"select","actors":{"kind":"buildings","where":{"can_research":1,"if":"(var(actor.uid) == var(b.uid)) * var(actor.idle) * (gameVar(food) >= 50) * (gameVar(wood) >= 50)"}},"issue":[{"research":{"tech_id":1}}]}]},
      {"action":"for_each","select":{"kind":"buildings","where":{"can_research":61}},"as":"b","do":[{"action":"select","actors":{"kind":"buildings","where":{"can_research":61,"if":"(var(actor.uid) == var(b.uid)) * var(actor.idle) * (gameVar(stone) >= 100) * (gameVar(gold) >= 100)"}},"issue":[{"research":{"tech_id":61}}]}]},
      {"action":"for_each","select":{"kind":"buildings","where":{"can_research":62}},"as":"b","do":[{"action":"select","actors":{"kind":"buildings","where":{"can_research":62,"if":"(var(actor.uid) == var(b.uid)) * var(actor.idle) * (gameVar(stone) >= 100) * (gameVar(gold) >= 100)"}},"issue":[{"research":{"tech_id":62}}]}]},
      {"action":"for_each","select":{"kind":"buildings","where":{"can_research":63}},"as":"b","do":[{"action":"select","actors":{"kind":"buildings","where":{"can_research":63,"if":"(var(actor.uid) == var(b.uid)) * var(actor.idle) * (gameVar(wood) >= 100) * (gameVar(gold) >= 100)"}},"issue":[{"research":{"tech_id":63}}]}]},
      {"action":"for_each","select":{"kind":"buildings","where":{"can_research":101}},"as":"b","do":[{"action":"select","actors":{"kind":"buildings","where":{"can_research":101,"if":"(var(actor.uid) == var(b.uid)) * var(actor.idle) * (gameVar(wood) >= 150)"}},"issue":[{"research":{"tech_id":101}}]}]}
    ]},
    {"when":{"always":{}},"then":[
      {"action":"for_each","select":{"kind":"buildings","where":{"can_create":1}},"as":"b","do":[{"action":"select","actors":{"kind":"buildings","where":{"can_create":1,"if":"(var(actor.uid) == var(b.uid)) * var(actor.idle) * (gameVar(food) >= 50) * (gameVar(population) < gameVar(population_limit))"}},"issue":[{"create":{"unit_id":1}}]}]},
      {"action":"for_each","select":{"kind":"buildings","where":{"can_create":101}},"as":"b","do":[{"action":"select","actors":{"kind":"buildings","where":{"can_create":101,"if":"(var(actor.uid) == var(b.uid)) * var(actor.idle) * (gameVar(food) >= 50) * (gameVar(wood) >= 20) * (gameVar(population) < gameVar(population_limit))"}},"issue":[{"create":{"unit_id":101}}]}]},
      {"action":"for_each","select":{"kind":"buildings","where":{"can_create":102}},"as":"b","do":[{"action":"select","actors":{"kind":"buildings","where":{"can_create":102,"if":"(var(actor.uid) == var(b.uid)) * var(actor.idle) * (gameVar(food) >= 70) * (gameVar(wood) >= 40) * (gameVar(population) < gameVar(population_limit))"}},"issue":[{"create":{"unit_id":102}}]}]},
      {"action":"for_each","select":{"kind":"buildings","where":{"can_create":103}},"as":"b","do":[{"action":"select","actors":{"kind":"buildings","where":{"can_create":103,"if":"(var(actor.uid) == var(b.uid)) * var(actor.idle) * (gameVar(food) >= 120) * (gameVar(gold) >= 70) * (gameVar(population) < gameVar(population_limit))"}},"issue":[{"create":{"unit_id":103}}]}]},
      {"action":"for_each","select":{"kind":"buildings","where":{"can_create":401}},"as":"b","do":[{"action":"select","actors":{"kind":"buildings","where":{"can_create":401,"if":"(var(actor.uid) == var(b.uid)) * var(actor.idle) * (gameVar(wood) >= 90) * (gameVar(stone) >= 40) * (gameVar(population) < gameVar(population_limit))"}},"issue":[{"create":{"unit_id":401}}]}]}
    ]},
    {"when":{"all":[{"value_at_most":{"value":{"count":{"kind":"buildings","where":{"building_ids":[1]}}},"amount":0}},{"value_equals":{"value":{"count":{"kind":"foundations","where":{"building_ids":[1]}}},"amount":0}}]},"then":[
      {"action":"select","actors":{"kind":"units","where":{"can_build":1,"in":{"order_kind":["gather","none"]},"if":"(gameVar(wood) >= 300) * (gameVar(stone) >= 100)"},"rank":"0 - var(actor.uid)","limit":1},"pick":{"kind":"zones","where":{"resource":false,"building":false}},"match":{"score":["0 - distance(actor, target, 1)","0 - var(target.x)","0 - var(target.y)","0 - var(target.zone_x)","0 - var(target.zone_y)"]},"issue":[{"build":{"building_id":1}}]}
    ]},
    {"when":{"all":[{"value_at_most":{"value":"var(barracks)","amount":3}},{"value_at_least":{"value":"var(villagers)","amount":"6 + 10 * var(barracks)"}},{"value_equals":{"value":{"count":{"kind":"foundations","where":{"building_ids":[22]}}},"amount":0}}]},"then":[
      {"action":"select","actors":{"kind":"units","where":{"can_build":22,"in":{"order_kind":["gather","none"]},"if":"(gameVar(wood) >= 150) * (gameVar(stone) >= 50)"},"rank":"0 - var(actor.uid)","limit":1},"pick":{"kind":"zones","where":{"resource":false,"building":false}},"match":{"score":["0 - distance(actor, target, 1)","0 - var(target.x)","0 - var(target.y)","0 - var(target.zone_x)","0 - var(target.zone_y)"]},"issue":[{"build":{"building_id":22}}]}
    ]},
    {"when":{"all":[{"value_at_least":{"value":"var(villagers)","amount":"20 + 20 * var(smiths)"}},{"value_at_most":{"value":{"count":{"kind":"buildings","where":{"building_ids":[11]}}},"amount":1}},{"value_equals":{"value":{"count":{"kind":"foundations","where":{"building_ids":[11]}}},"amount":0}}]},"then":[
      {"action":"select","actors":{"kind":"units","where":{"can_build":11,"in":{"order_kind":["gather","none"]},"if":"(gameVar(wood) >= 100) * (gameVar(stone) >= 100)"},"rank":"0 - var(actor.uid)","limit":1},"pick":{"kind":"zones","where":{"resource":false,"building":false}},"match":{"score":["0 - distance(actor, target, 1)","0 - var(target.x)","0 - var(target.y)","0 - var(target.zone_x)","0 - var(target.zone_y)"]},"issue":[{"build":{"building_id":11}}]}
    ]},
    {"when":{"all":[{"value_at_most":{"value":"var(redoubts)","amount":3}},{"value_at_least":{"value":"var(villagers)","amount":"14 + 10 * var(redoubts)"}},{"value_equals":{"value":{"count":{"kind":"foundations","where":{"building_ids":[23]}}},"amount":0}}]},"then":[
      {"action":"select","actors":{"kind":"units","where":{"can_build":23,"in":{"order_kind":["gather","none"]},"if":"(gameVar(wood) >= 250) * (gameVar(stone) >= 250)"},"rank":"0 - var(actor.uid)","limit":1},"pick":{"kind":"zones","where":{"resource":false,"building":false}},"match":{"score":["0 - distance(actor, target, 1)","0 - var(target.x)","0 - var(target.y)","0 - var(target.zone_x)","0 - var(target.zone_y)"]},"issue":[{"build":{"building_id":23}}]}
    ]},
    {"when":{"always":{}},"then":[
      {"action":"select","actors":{"kind":"units","where":{"can_build":3,"in":{"order_kind":["gather","none"]},"if":"gameVar(wood) >= 60"},"rank":"0 - var(actor.uid)","limit":1},"pick":{"kind":"buildings","where":{"building_ids":[3],"if":"(var(target.resources_left) == 0) * (1 - var(target.is_under_construction)) * (1 - var(target.is_renewing))"}},"match":{"score":["0 - distance(actor, target, 1)","0 - var(target.uid)"]},"issue":[{"renew":{}}]}
    ]},
    {"when":{"all":[{"tech_researched":{"tech_id":1}},{"value_at_most":{"value":{"sum":{"kind":"resources","where":{"category":"food","near":{"distance":1,"of":{"kind":"buildings","where":{"building_ids":[1]}}}},"of":"var(item.amount_left)"}},"amount":400}},{"value_at_most":{"value":{"count":{"kind":"buildings","where":{"building_ids":[3]}}},"amount":"max(1, round(var(villagers) / 4)) - 1"}},{"value_equals":{"value":{"count":{"kind":"foundations","where":{"building_ids":[3]}}},"amount":0}}]},"then":[
      {"action":"select","actors":{"kind":"units","where":{"can_build":3,"in":{"order_kind":["gather","none"]},"if":"gameVar(wood) >= 80"},"rank":"0 - var(actor.uid)","limit":1},"pick":{"kind":"zones","where":{"resource":false,"building":false,"near":{"distance":1,"of":{"kind":"buildings","where":{"building_ids":[1]}}}}},"match":{"score":["0 - distance(actor, target, 1)","0 - var(target.x)","0 - var(target.y)","0 - var(target.zone_x)","0 - var(target.zone_y)"]},"issue":[{"build":{"building_id":3}}]}
    ]},
    {"when":{"always":{}},"then":[
      {"action":"set_var","name":"food_workers","value":{"count":{"kind":"units","where":{"bucket":"gather_food"}}}},
      {"action":"set_var","name":"wood_workers","value":{"count":{"kind":"units","where":{"bucket":"gather_wood"}}}},
      {"action":"set_var","name":"stone_workers","value":{"count":{"kind":"units","where":{"bucket":"gather_stone"}}}},
      {"action":"set_var","name":"centers","value":{"count":{"kind":"buildings","where":{"building_ids":[1]}}}},
      {"action":"set_var","name":"pending_centers","value":{"count":{"kind":"foundations","where":{"building_ids":[1]}}}},
      {"action":"set_var","name":"pending_barracks","value":{"count":{"kind":"foundations","where":{"building_ids":[22]}}}},
      {"action":"set_var","name":"pending_smiths","value":{"count":{"kind":"foundations","where":{"building_ids":[11]}}}},
      {"action":"set_var","name":"pending_redoubts","value":{"count":{"kind":"foundations","where":{"building_ids":[23]}}}},
      {"action":"set_var","name":"plan_barracks","value":"(var(barracks) < 4) * (var(pending_barracks) == 0) * (var(villagers) >= max(3, 6 + 10 * var(barracks) - 4))"},
      {"action":"set_var","name":"plan_smith","value":"(var(smiths) < 2) * (var(pending_smiths) == 0) * (var(villagers) >= 16 + 20 * var(smiths))"},
      {"action":"set_var","name":"plan_redoubt","value":"(var(redoubts) < 4) * (var(pending_redoubts) == 0) * (var(villagers) >= 10 + 10 * var(redoubts))"},
      {"action":"set_var","name":"local_food","value":{"sum":{"kind":"resources","where":{"category":"food","near":{"distance":1,"of":{"kind":"buildings","where":{"building_ids":[1]}}}},"of":"var(item.amount_left)"}}},
      {"action":"set_var","name":"food_goal","value":"6 * config(unit, cost_food, 1) * (var(centers) > 0) + 2 * (var(barracks) * config(unit, cost_food, 101) + var(redoubts) * config(unit, cost_food, 103))"},
      {"action":"set_var","name":"wood_goal","value":"max((var(centers) == 0) * (var(pending_centers) == 0) * config(building, cost_wood, 1), var(plan_barracks) * config(building, cost_wood, 22), var(plan_smith) * config(building, cost_wood, 11), var(plan_redoubt) * config(building, cost_wood, 23)) + 2 * config(building, cost_wood, 2) + 3 * max(1, var(barracks)) * config(unit, cost_wood, 101) + (var(local_food) <= 400) * researched(1) * config(building, cost_wood, 3)"},
      {"action":"set_var","name":"stone_goal","value":"max((var(centers) == 0) * (var(pending_centers) == 0) * config(building, cost_stone, 1), var(plan_barracks) * config(building, cost_stone, 22), var(plan_smith) * config(building, cost_stone, 11), var(plan_redoubt) * config(building, cost_stone, 23), (var(smiths) > 0) * (1 - researched(61) * researched(62)) * config(tech, cost_stone, 61))"},
      {"action":"set_var","name":"food_weight","value":"max(config(unit, cost_food, 1) / 2, var(food_goal) - gameVar(food))"},
      {"action":"set_var","name":"wood_weight","value":"max(config(building, cost_wood, 2), var(wood_goal) - gameVar(wood))"},
      {"action":"set_var","name":"stone_weight","value":"max(0, var(stone_goal) - gameVar(stone))"},
      {"action":"set_var","name":"capacity_food","value":{"sum":{"kind":"gatherables","where":{"category":"food"},"of":"var(item.gather_capacity)"}}},
      {"action":"set_var","name":"capacity_wood","value":{"sum":{"kind":"gatherables","where":{"category":"wood"},"of":"var(item.gather_capacity)"}}},
      {"action":"set_var","name":"capacity_stone","value":{"sum":{"kind":"gatherables","where":{"category":"stone"},"of":"var(item.gather_capacity)"}}},
      {"action":"set_var","name":"weight_total","value":"var(food_weight) + var(wood_weight) + var(stone_weight)"},
      {"action":"set_var","name":"wanted_food","value":"min(var(capacity_food), var(villagers) * var(food_weight) / var(weight_total))"},
      {"action":"set_var","name":"wanted_wood","value":"min(var(capacity_wood), var(villagers) * var(wood_weight) / var(weight_total))"},
      {"action":"set_var","name":"wanted_stone","value":"min(var(capacity_stone), var(villagers) * var(stone_weight) / var(weight_total))"},
      {"action":"set_var","name":"food_gap","value":"var(wanted_food) - var(food_workers)"},
      {"action":"set_var","name":"wood_gap","value":"var(wanted_wood) - var(wood_workers)"},
      {"action":"set_var","name":"stone_gap","value":"var(wanted_stone) - var(stone_workers)"},
      {"action":"if","when":{"all":[{"value_at_least":{"value":"gameVar(turn)","amount":"var(last_rebalance) + 3"}},{"value_at_most":{"value":"min(var(food_gap), var(wood_gap), var(stone_gap))","amount":-2}},{"value_at_least":{"value":"max(var(food_gap), var(wood_gap), var(stone_gap))","amount":2}}]},"then":[
        {"action":"set_var","name":"donor","value":"(var(wood_gap) < var(food_gap)) * (var(wood_gap) <= var(stone_gap)) + 2 * (var(stone_gap) < var(food_gap)) * (var(stone_gap) < var(wood_gap))"},
        {"action":"if","when":{"value_equals":{"value":"var(donor)","amount":0}},"then":[{"action":"select","pick":{"kind":"units","where":{"bucket":"gather_food","in":{"order_kind":["gather","none"]}},"rank":["var(target.idle)","0 - var(target.uid)"],"limit":1},"into":{"set":"supply_worker","var":"rebalanced"}}]},
        {"action":"if","when":{"value_equals":{"value":"var(donor)","amount":1}},"then":[{"action":"select","pick":{"kind":"units","where":{"bucket":"gather_wood","in":{"order_kind":["gather","none"]}},"rank":["var(target.idle)","0 - var(target.uid)"],"limit":1},"into":{"set":"supply_worker","var":"rebalanced"}}]},
        {"action":"if","when":{"value_equals":{"value":"var(donor)","amount":2}},"then":[{"action":"select","pick":{"kind":"units","where":{"bucket":"gather_stone","in":{"order_kind":["gather","none"]}},"rank":["var(target.idle)","0 - var(target.uid)"],"limit":1},"into":{"set":"supply_worker","var":"rebalanced"}}]},
        {"action":"select","pick":{"kind":"units","where":{"in_set":"supply_worker"}},"into":{"bucket":"all","mode":"remove"}},
        {"action":"select","actors":{"kind":"units","where":{"in_set":"supply_worker"}},"issue":[{"stop":{"orders":["gather"]}}]},
        {"action":"set_var","name":"food_workers","value":"var(food_workers) - var(rebalanced) * (var(donor) == 0)"},
        {"action":"set_var","name":"wood_workers","value":"var(wood_workers) - var(rebalanced) * (var(donor) == 1)"},
        {"action":"set_var","name":"stone_workers","value":"var(stone_workers) - var(rebalanced) * (var(donor) == 2)"},
        {"action":"set_var","name":"last_rebalance","value":"gameVar(turn)","persist":true}
      ]},
      {"action":"for_each","select":{"kind":"units","where":{"unit_types":["economic"],"bucket":"none","in":{"order_kind":["gather","none"]}},"rank":"0 - var(worker.uid)"},"as":"worker","do":[
        {"action":"set_var","name":"food_gap","value":"(var(food_workers) < var(capacity_food)) * (var(wanted_food) - var(food_workers)) - 1000000 * (var(food_workers) >= var(capacity_food))"},
        {"action":"set_var","name":"wood_gap","value":"(var(wood_workers) < var(capacity_wood)) * (var(wanted_wood) - var(wood_workers)) - 1000000 * (var(wood_workers) >= var(capacity_wood))"},
        {"action":"set_var","name":"stone_gap","value":"(var(stone_workers) < var(capacity_stone)) * (var(wanted_stone) - var(stone_workers)) - 1000000 * (var(stone_workers) >= var(capacity_stone))"},
        {"action":"set_var","name":"category","value":"(var(wood_gap) > var(food_gap)) * (var(wood_gap) >= var(stone_gap)) + 2 * (var(stone_gap) > var(food_gap)) * (var(stone_gap) > var(wood_gap))"},
        {"action":"if","when":{"value_equals":{"value":"var(category)","amount":0}},"then":[{"action":"select","pick":{"kind":"units","where":{"unit_types":["economic"],"if":"var(target.uid) == var(worker.uid)"}},"into":{"bucket":"gather_food","mode":"add"}}]},
        {"action":"if","when":{"value_equals":{"value":"var(category)","amount":1}},"then":[{"action":"select","pick":{"kind":"units","where":{"unit_types":["economic"],"if":"var(target.uid) == var(worker.uid)"}},"into":{"bucket":"gather_wood","mode":"add"}}]},
        {"action":"if","when":{"value_equals":{"value":"var(category)","amount":2}},"then":[{"action":"select","pick":{"kind":"units","where":{"unit_types":["economic"],"if":"var(target.uid) == var(worker.uid)"}},"into":{"bucket":"gather_stone","mode":"add"}}]},
        {"action":"set_var","name":"food_workers","value":"var(food_workers) + (var(category) == 0)"},
        {"action":"set_var","name":"wood_workers","value":"var(wood_workers) + (var(category) == 1)"},
        {"action":"set_var","name":"stone_workers","value":"var(stone_workers) + (var(category) == 2)"}
      ]},
