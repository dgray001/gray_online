{
  "rules": [
    {"when": {"population_at_most": {"amount": 19, "unit_ids": [1]}}, "then": [{"action": "add_q", "type": "unit", "id": 1, "weight": 10}, {"action": "add_q", "type": "unit", "id": 1, "weight": 8}, {"action": "add_q", "type": "unit", "id": 1, "weight": 6}, {"action": "add_q", "type": "unit", "id": 1, "weight": 4}, {"action": "add_q", "type": "unit", "id": 1, "weight": 2}]},
    {"when": {"all": [{"population_at_least": {"amount": 20, "unit_ids": [1]}}, {"population_at_most": {"amount": 39, "unit_ids": [1]}}]}, "then": [{"action": "add_q", "type": "unit", "id": 1, "weight": 7}, {"action": "add_q", "type": "unit", "id": 1, "weight": 5}, {"action": "add_q", "type": "unit", "id": 1, "weight": 3}, {"action": "add_q", "type": "unit", "id": 1, "weight": 2}, {"action": "add_q", "type": "unit", "id": 1, "weight": 1}]},
    {"when": {"population_headroom_at_most": {"amount": 0}}, "then": [{"action": "add_q", "type": "building", "id": 2, "weight": 12}]},
    {"when": {"population_headroom_equals": {"amount": 1}}, "then": [{"action": "add_q", "type": "building", "id": 2, "weight": 9}]},
    {"when": {"all": [{"building_count_equals": {"building_ids": [22], "amount": 0}}, {"population_at_least": {"amount": 6, "unit_ids": [1]}}]}, "then": [{"action": "add_q", "type": "building", "id": 22, "weight": 30}]},
    {"when": {"all": [{"building_count_equals": {"building_ids": [22], "amount": 1}}, {"population_at_least": {"amount": 16, "unit_ids": [1]}}]}, "then": [{"action": "add_q", "type": "building", "id": 22, "weight": 30}]},
    {"when": {"all": [{"building_count_equals": {"building_ids": [22], "amount": 2}}, {"population_at_least": {"amount": 24, "unit_ids": [1]}}]}, "then": [{"action": "add_q", "type": "building", "id": 22, "weight": 30}]},
    {"when": {"always": {}}, "then": [{"action": "gather", "eligible": ["gather"]}]},
    {"when": {"always": {}}, "then": [{"action": "create", "unit_id": 11}]},
    {"when": {"always": {}}, "then": [{"action": "create", "unit_id": 1}]},
    {"when": {"always": {}}, "then": [{"action": "buildNextInQ", "eligible": ["gather"], "max": 1, "weight": 7, "prioritize": true}]},
    {"when": {"always": {}}, "then": [{"action": "set_unit_behavior", "unit_types": ["infantry"], "target_priority": ["economic", "military", "building"]}]},
    {"when": {"always": {}}, "then": [{"action": "attack"}, {"action": "explore"}]}
  ]
}
