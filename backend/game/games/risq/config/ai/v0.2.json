{
  "rules": [
    {"when": {"always": {}}, "then": [
      {"action":"set_var","name":"headroom","value":"population_limit - population"},
      {"action":"set_var","name":"house_weight","value":"12 * (var(headroom) <= 0) + 9 * (var(headroom) == 1)"},
      {"action":"set_var","name":"barracks_first_pop","value":"6 + 10 * (var(building_count_22) >= 1) + 8 * (var(building_count_22) >= 2)"},
      {"action":"set_var","name":"barracks_weight","value":"(var(building_count_22) <= 2) * (9 * (var(population_1) >= var(barracks_first_pop)) + 6 * (var(population_1) >= var(barracks_first_pop) + 6) + 15 * (var(population_1) >= var(barracks_first_pop) + 12))"},
      {"action":"set_var","name":"q_unit1","value":"5 * (var(population_1) <= 39) + 3 * (var(population_1) >= 40) * (var(population_1) <= 47) + (var(population_1) >= 48) * (var(population_1) <= 49)"},
      {"action":"set_var","name":"q_house","value":"2 * (var(headroom) <= 1) + (var(headroom) >= 2) * (var(headroom) <= 5)"},
      {"action":"set_var","name":"q_barracks","value":"(var(building_count_22) == 0) * (var(population_1) >= 2) + (var(building_count_22) == 1) * (var(population_1) >= 12) + (var(building_count_22) == 2) * (var(population_1) >= 20)"},
      {"action":"set_var","name":"q_blacksmith","value":"var(building_count_11) <= 1"},
      {"action":"set_var","name":"q_redoubt","value":"var(building_count_23) <= 3"},
      {"action":"set_var","name":"q_tech","value":"var(population_1) >= 6"},
      {"action":"set_var","name":"q_soldiers","value":"population >= 4"},
      {"action":"set_var","name":"q_heavies","value":"population >= 6"},
      {"action":"set_var","name":"need_food","value":"max(0, 50 * var(q_unit1) + 50 * var(q_tech) + 120 * var(q_soldiers) + 120 * var(q_heavies) - food)"},
      {"action":"set_var","name":"need_wood","value":"max(0, 30 * var(q_house) + 150 * var(q_barracks) + 100 * var(q_blacksmith) + 250 * var(q_redoubt) + 50 * var(q_tech) + 60 * var(q_soldiers) - wood)"},
      {"action":"set_var","name":"need_stone","value":"max(0, 50 * var(q_barracks) + 100 * var(q_blacksmith) + 250 * var(q_redoubt) - stone)"},
      {"action":"set_var","name":"need_total","value":"var(need_food) + var(need_wood) + var(need_stone)"},
      {"action":"set_var","name":"need_even","value":"var(need_total) <= 0"},
      {"action":"set_var","name":"need_food","value":"var(need_food) + var(need_even)"},{"action":"set_var","name":"need_wood","value":"var(need_wood) + var(need_even)"},{"action":"set_var","name":"need_stone","value":"var(need_stone) + var(need_even)"},{"action":"set_var","name":"need_total","value":"var(need_total) + 3 * var(need_even)"}]},
    {"when": {"always": {}}, "then": [
      {"action":"select","pick":{"kind":"units","where":{"unit_types":["economic"],"in":{"order_kind":["gather"]}}},"into":{"set":"existing_gatherers"}},
      {"action":"set_var","name":"gather_food","value":0},{"action":"set_var","name":"gather_wood","value":0},{"action":"set_var","name":"gather_stone","value":0},{"action":"set_var","name":"avail0","value":0},{"action":"set_var","name":"avail1","value":0},{"action":"set_var","name":"avail2","value":0},
      {"action":"for_each","select":{"kind":"gatherables","let":{"workers":{"count":{"kind":"units","where":{"in":{"order_kind":["gather"]},"if":"var(item.order_target_uid) == var(resource.uid)"}}}}},"as":"resource","do":[
        {"action":"set_var","name":"w","value":"var(resource.workers)"},
        {"action":"set_var","name":"gather_food","value":"var(gather_food) + (var(resource.category) == 0) * var(w)"},{"action":"set_var","name":"gather_wood","value":"var(gather_wood) + (var(resource.category) == 1) * var(w)"},{"action":"set_var","name":"gather_stone","value":"var(gather_stone) + (var(resource.category) == 2) * var(w)"},
        {"action":"set_var","name":"avail0","value":"var(avail0) + (var(resource.category) == 0) * (var(resource.gather_capacity) > var(w))"},{"action":"set_var","name":"avail1","value":"var(avail1) + (var(resource.category) == 1) * (var(resource.gather_capacity) > var(w))"},{"action":"set_var","name":"avail2","value":"var(avail2) + (var(resource.category) == 2) * (var(resource.gather_capacity) > var(w))"}]},
      {"action":"set_var","name":"idle_workers","value":{"count":{"kind":"units","where":{"unit_types":["economic"],"if":"var(item.idle)"}}}},
      {"action":"set_var","name":"workers_total","value":"var(gather_food) + var(gather_wood) + var(gather_stone) + var(idle_workers)"},
      {"action":"set_var","name":"target0","value":"var(need_food) / var(need_total) * var(workers_total)"},{"action":"set_var","name":"target1","value":"var(need_wood) / var(need_total) * var(workers_total)"},{"action":"set_var","name":"target2","value":"var(need_stone) / var(need_total) * var(workers_total)"},
      {"action":"for_each","select":{"kind":"units","where":{"unit_types":["economic"],"if":"var(u.idle)"}},"as":"u","do":[
        {"action":"set_var","name":"key0","value":"(var(avail0) > 0) * (var(target0) - var(gather_food)) - 1000000000 * (var(avail0) <= 0)"},{"action":"set_var","name":"key1","value":"(var(avail1) > 0) * (var(target1) - var(gather_wood)) - 1000000000 * (var(avail1) <= 0)"},{"action":"set_var","name":"key2","value":"(var(avail2) > 0) * (var(target2) - var(gather_stone)) - 1000000000 * (var(avail2) <= 0)"},
        {"action":"set_var","name":"first_wins","value":"(var(key0) >= var(key1)) * (var(key0) >= var(key2))"},
        {"action":"set_var","name":"pick_cat","value":"(1 - var(first_wins)) * (var(key1) >= var(key2)) + 2 * (1 - var(first_wins)) * (var(key2) > var(key1))"},
        {"action":"if","when":{"value_at_least":{"value":"(var(avail0) > 0) + (var(avail1) > 0) + (var(avail2) > 0)","amount":1}},"then":[
          {"action":"select","actors":{"kind":"units","where":{"if":"var(actor.uid) == var(u.uid)"}},"pick":{"kind":"gatherables","let":{"workers":{"count":{"kind":"units","where":{"in":{"order_kind":["gather"]},"if":"var(item.order_target_uid) == var(target.uid)"}}},"nx":"2 * max(var(target.x), 0 - var(target.x)) - (var(target.x) < 0)","ny":"2 * max(var(target.y), 0 - var(target.y)) - (var(target.y) < 0)","nzx":"2 * max(var(target.zone_x), 0 - var(target.zone_x)) - (var(target.zone_x) < 0)","nzy":"2 * max(var(target.zone_y), 0 - var(target.zone_y)) - (var(target.zone_y) < 0)","space_key":"(var(target.nx) + var(target.ny)) * (var(target.nx) + var(target.ny) + 1) / 2 + var(target.ny)","local_key":"(var(target.nzx) + var(target.nzy)) * (var(target.nzx) + var(target.nzy) + 1) / 2 + var(target.nzy)","zone_key":"(2 * var(target.space_key) + 2 * var(target.local_key)) * (2 * var(target.space_key) + 2 * var(target.local_key) + 1) / 2 + 2 * var(target.local_key)"},"where":{"if":["var(target.category) == var(pick_cat)","var(target.gather_capacity) - var(target.workers) > 0"]}},"assign":{"capacity":"var(target.gather_capacity) - var(target.workers)","overflow":"none","unit_score":"0 - 10000000000000 * (var(target.amount_left) <= (var(target.workers) + var(target_assigned)) * var(target.gather_speed)) - 1000000000 * var(target.zone_distance_to_actor) - var(target.zone_key)"},"issue":[{"gather":{}}]},
          {"action":"set_var","name":"gather_food","value":"var(gather_food) + (var(pick_cat) == 0)"},{"action":"set_var","name":"gather_wood","value":"var(gather_wood) + (var(pick_cat) == 1)"},{"action":"set_var","name":"gather_stone","value":"var(gather_stone) + (var(pick_cat) == 2)"},
          {"action":"set_var","name":"chosen_id","value":{"max":{"kind":"units","where":{"if":"var(item.uid) == var(u.uid)"},"of":"var(item.order_target_uid)","default":0}}},
          {"action":"for_each","select":{"kind":"gatherables","where":{"if":"var(node.uid) == var(chosen_id)"},"let":{"workers":{"count":{"kind":"units","where":{"in":{"order_kind":["gather"]},"if":"var(item.order_target_uid) == var(node.uid)"}}}}},"as":"node","do":[
            {"action":"set_var","name":"w","value":"var(node.workers)"},
            {"action":"set_var","name":"avail0","value":"var(avail0) - (var(node.category) == 0) * (var(w) >= var(node.gather_capacity))"},{"action":"set_var","name":"avail1","value":"var(avail1) - (var(node.category) == 1) * (var(w) >= var(node.gather_capacity))"},{"action":"set_var","name":"avail2","value":"var(avail2) - (var(node.category) == 2) * (var(w) >= var(node.gather_capacity))"}]}]}]},
      {"action":"for_each","select":{"kind":"units","where":{"in_set":"existing_gatherers"}},"as":"worker","do":[
