          "actors": {"kind": "units", "where": {"unit_types": ["military"], "if": "var(actor.idle)"}},
          "pick": {"kind": "attackables", "where": {"if": "var(target.is_visible)"}},
          "assign": {"capacity": 100000, "unit_order": "0 - var(actor.uid)", "unit_score": "0 - 10000000000000 * ((var(target.target_category) == 1) + 2 * (var(target.target_category) == 3)) - 1000000 * var(target.zone_distance_to_actor) - var(target.uid)"},
          "issue": [{"attack": {}}]
        },
        {"action":"set_var","name":"unexplored","value":{"count":{"kind":"spaces","where":{"vision":0}}}},
        {"action":"if","when":{"value_at_least":{"value":"var(unexplored)","amount":1}},"then":[
          {"action":"for_each","select":{"kind":"units","where":{"if":"var(u.idle)"}},"as":"u","do":[
            {"action":"set_var","name":"dmin","value":0},{"action":"set_var","name":"ux","value":"var(u.x)"},{"action":"set_var","name":"uy","value":"var(u.y)"},
            {"action":"set_var","name":"cnt","value":{"count":{"kind":"spaces","where":{"vision":0,"near":{"distance":"var(dmin) + 31","of":{"x":"var(ux)","y":"var(uy)"}}}}}},{"action":"set_var","name":"dmin","value":"var(dmin) + 32 * (var(cnt) == 0)"},
            {"action":"set_var","name":"cnt","value":{"count":{"kind":"spaces","where":{"vision":0,"near":{"distance":"var(dmin) + 15","of":{"x":"var(ux)","y":"var(uy)"}}}}}},{"action":"set_var","name":"dmin","value":"var(dmin) + 16 * (var(cnt) == 0)"},
            {"action":"set_var","name":"cnt","value":{"count":{"kind":"spaces","where":{"vision":0,"near":{"distance":"var(dmin) + 7","of":{"x":"var(ux)","y":"var(uy)"}}}}}},{"action":"set_var","name":"dmin","value":"var(dmin) + 8 * (var(cnt) == 0)"},
            {"action":"set_var","name":"cnt","value":{"count":{"kind":"spaces","where":{"vision":0,"near":{"distance":"var(dmin) + 3","of":{"x":"var(ux)","y":"var(uy)"}}}}}},{"action":"set_var","name":"dmin","value":"var(dmin) + 4 * (var(cnt) == 0)"},
            {"action":"set_var","name":"cnt","value":{"count":{"kind":"spaces","where":{"vision":0,"near":{"distance":"var(dmin) + 1","of":{"x":"var(ux)","y":"var(uy)"}}}}}},{"action":"set_var","name":"dmin","value":"var(dmin) + 2 * (var(cnt) == 0)"},
            {"action":"set_var","name":"cnt","value":{"count":{"kind":"spaces","where":{"vision":0,"near":{"distance":"var(dmin)","of":{"x":"var(ux)","y":"var(uy)"}}}}}},{"action":"set_var","name":"dmin","value":"var(dmin) + (var(cnt) == 0)"},
            {"action":"select",
              "actors":{"kind":"units","where":{"if":"var(actor.uid) == var(u.uid)"}},
              "pick":{"kind":"spaces","where":{"vision":0,"near":{"distance":"var(dmin)","of":{"x":"var(ux)","y":"var(uy)"}}},"let":{"claimed":{"count":{"kind":"units","where":{"in":{"order_kind":["move"]},"if":"(var(item.order_space_x) == var(target.x)) * (var(item.order_space_y) == var(target.y)) * (var(item.order_zone_x) == 0) * (var(item.order_zone_y) == 0)"}}}},"rank":["0","0 - (var(target.y) * 100000 + var(target.x))"]},
              "assign":{"unit_score":"0 - (var(target.claimed) > 0)"},
              "issue":[{"move":{"to":"zone"}}]}]}]}
      ]
    }
  ]
}
