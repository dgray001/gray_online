        {"action":"for_each","select":{"kind":"gatherables","where":{"if":"var(node.uid) == var(old_id)"}},"as":"node","do":[{"action":"set_var","name":"gather_from","value":"var(node.category)"}]},
        {"action":"set_var","name":"ok0","value":"((var(avail0) > 0) + (var(gather_from) == 0)) > 0"},{"action":"set_var","name":"ok1","value":"((var(avail1) > 0) + (var(gather_from) == 1)) > 0"},{"action":"set_var","name":"ok2","value":"((var(avail2) > 0) + (var(gather_from) == 2)) > 0"},
        {"action":"set_var","name":"key0","value":"var(ok0) * (var(target0) - var(gather_food)) - 1000000000 * (1 - var(ok0))"},{"action":"set_var","name":"key1","value":"var(ok1) * (var(target1) - var(gather_wood)) - 1000000000 * (1 - var(ok1))"},{"action":"set_var","name":"key2","value":"var(ok2) * (var(target2) - var(gather_stone)) - 1000000000 * (1 - var(ok2))"},
        {"action":"set_var","name":"first_wins","value":"(var(key0) >= var(key1)) * (var(key0) >= var(key2))"},
        {"action":"set_var","name":"pick_cat","value":"(1 - var(first_wins)) * (var(key1) >= var(key2)) + 2 * (1 - var(first_wins)) * (var(key2) > var(key1))"},
        {"action":"set_var","name":"deficit_from","value":"(var(gather_from) == 0) * (var(target0) - var(gather_food)) + (var(gather_from) == 1) * (var(target1) - var(gather_wood)) + (var(gather_from) == 2) * (var(target2) - var(gather_stone))"},
        {"action":"set_var","name":"deficit_pick","value":"(var(pick_cat) == 0) * (var(target0) - var(gather_food)) + (var(pick_cat) == 1) * (var(target1) - var(gather_wood)) + (var(pick_cat) == 2) * (var(target2) - var(gather_stone))"},
        {"action":"if","when":{"value_at_least":{"value":"(var(ok0) + var(ok1) + var(ok2) >= 1) * (var(pick_cat) != var(gather_from)) * (var(deficit_pick) - var(deficit_from) > 3)","amount":1}},"then":[
          {"action":"select","actors":{"kind":"units","where":{"if":"var(actor.uid) == var(worker.uid)"}},"pick":{"kind":"gatherables","let":{"workers":{"count":{"kind":"units","where":{"in":{"order_kind":["gather"]},"if":"var(item.order_target_uid) == var(target.uid)"}}},"nx":"2 * max(var(target.x), 0 - var(target.x)) - (var(target.x) < 0)","ny":"2 * max(var(target.y), 0 - var(target.y)) - (var(target.y) < 0)","nzx":"2 * max(var(target.zone_x), 0 - var(target.zone_x)) - (var(target.zone_x) < 0)","nzy":"2 * max(var(target.zone_y), 0 - var(target.zone_y)) - (var(target.zone_y) < 0)","space_key":"(var(target.nx) + var(target.ny)) * (var(target.nx) + var(target.ny) + 1) / 2 + var(target.ny)","local_key":"(var(target.nzx) + var(target.nzy)) * (var(target.nzx) + var(target.nzy) + 1) / 2 + var(target.nzy)","zone_key":"(2 * var(target.space_key) + 2 * var(target.local_key)) * (2 * var(target.space_key) + 2 * var(target.local_key)  + 1) / 2 + 2 * var(target.local_key)"},"where":{"if":["var(target.category) == var(pick_cat)","var(target.gather_capacity) - var(target.workers) > 0"]}},"assign":{"capacity":"var(target.gather_capacity) - var(target.workers)","overflow":"none","unit_score":"0 - 10000000000000 * (var(target.amount_left) <= (var(target.workers) + var(target_assigned)) * var(target.gather_speed)) - 1000000000 * var(target.zone_distance_to_actor) - var(target.zone_key)"},"issue":[{"gather":{}}]},
          {"action":"set_var","name":"gather_food","value":"var(gather_food) - (var(gather_from) == 0) + (var(pick_cat) == 0)"},{"action":"set_var","name":"gather_wood","value":"var(gather_wood) - (var(gather_from) == 1) + (var(pick_cat) == 1)"},{"action":"set_var","name":"gather_stone","value":"var(gather_stone) - (var(gather_from) == 2) + (var(pick_cat) == 2)"},
          {"action":"set_var","name":"chosen_id","value":{"max":{"kind":"units","where":{"if":"var(item.uid) == var(worker.uid)"},"of":"var(item.order_target_uid)","default":0}}},
          {"action":"for_each","select":{"kind":"gatherables","where":{"if":"(var(node.uid) == var(old_id)) + (var(node.uid) == var(chosen_id))"},"let":{"workers":{"count":{"kind":"units","where":{"in":{"order_kind":["gather"]},"if":"var(item.order_target_uid) == var(node.uid)"}}}}},"as":"node","do":[
            {"action":"set_var","name":"w","value":"var(node.workers)"},
            {"action":"set_var","name":"avail0","value":"var(avail0) + (var(node.category) == 0) * ((var(node.uid) == var(old_id)) * (var(w) == var(node.gather_capacity) - 1) - (var(node.uid) == var(chosen_id)) * (var(w) >= var(node.gather_capacity)))"},{"action":"set_var","name":"avail1","value":"var(avail1) + (var(node.category) == 1) * ((var(node.uid) == var(old_id)) * (var(w) == var(node.gather_capacity) - 1) - (var(node.uid) == var(chosen_id)) * (var(w) >= var(node.gather_capacity)))"},{"action":"set_var","name":"avail2","value":"var(avail2) + (var(node.category) == 2) * ((var(node.uid) == var(old_id)) * (var(w) == var(node.gather_capacity) - 1) - (var(node.uid) == var(chosen_id)) * (var(w) >= var(node.gather_capacity)))"}]}]}]}
