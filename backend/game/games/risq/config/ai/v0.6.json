{
  "rules": [
    {"when": {"always": {}}, "then": [{"action": "set_var", "name": "vils", "value": "var(population_1)"}, {"action": "set_var", "name": "B", "value": "var(population_11)"}, {"action": "set_var", "name": "Pi", "value": "var(population_12)"}, {"action": "set_var", "name": "Hv", "value": "var(population_13)"}, {"action": "set_var", "name": "mil", "value": "var(B) + var(Pi) + var(Hv)"}, {"action": "set_var", "name": "headroom", "value": "population_limit - population"}, {"action": "set_var", "name": "vcs", "value": "var(building_count_1_complete)"}, {"action": "set_var", "name": "barracks", "value": "var(building_count_22_complete)"}, {"action": "set_var", "name": "redoubts", "value": "var(building_count_23_complete)"}, {"action": "set_var", "name": "smiths", "value": "var(building_count_11_complete)"}, {"action": "set_var", "name": "farming", "value": "var(tech_researched_1)"}, {"action": "set_var", "name": "pikes", "value": "var(tech_researched_5)"}, {"action": "set_var", "name": "rate", "value": "6 + 1.5 * var(farming)"}]},
    {"when": {"always": {}}, "then": [{"action": "set_var", "name": "eB", "value": "max(var(eB) - 0.3, var(enemy_units_visible_11))", "persist": true}, {"action": "set_var", "name": "eP", "value": "max(var(eP) - 0.3, var(enemy_units_visible_12))", "persist": true}, {"action": "set_var", "name": "eH", "value": "max(var(eH) - 0.3, var(enemy_units_visible_13))", "persist": true}, {"action": "set_var", "name": "eV", "value": "max(var(eV) - 0.3, var(enemy_units_visible_1))", "persist": true}, {"action": "set_var", "name": "eMil", "value": "var(eB) + var(eP) + var(eH)"}, {"action": "set_var", "name": "ePow", "value": "var(eB) + 2 * var(eP) + 4 * var(eH)"}]},
    {"when": {"always": {}}, "then": [{"action": "set_var", "name": "es", "value": "var(eB) + var(eP) + var(eH) + 1"}, {"action": "set_var", "name": "vB", "value": "(var(eB) + 1.3 * var(eP) + 0.4 * var(eH) + 1 + 3 * min(1, max(0, 1 - var(redoubts)))) / var(es)"}, {"action": "set_var", "name": "vP", "value": "(0.75 * var(eB) + var(eP) + (0.8 + 0.5 * var(pikes)) * var(eH) + 0.5) / var(es)"}, {"action": "set_var", "name": "vH", "value": "(1.3 * var(eB) + 0.8 * var(eP) + var(eH) + 1) / var(es)"}, {"action": "set_var", "name": "barracks_spend", "value": "max((var(unit_cost_food_11) + var(unit_cost_wood_11) + var(unit_cost_stone_11)) * 1.0, (var(unit_cost_food_12) + var(unit_cost_wood_12) + var(unit_cost_stone_12)) * 0.71)"}, {"action": "set_var", "name": "redoubt_spend", "value": "(var(unit_cost_food_13) + var(unit_cost_wood_13) + var(unit_cost_stone_13)) * 0.25"}, {"action": "set_var", "name": "n_barracks", "value": "var(building_count_22)"}, {"action": "set_var", "name": "n_redoubts", "value": "var(building_count_23)"}, {"action": "set_var", "name": "committed", "value": "var(vcs) * (var(unit_cost_food_1) + var(unit_cost_wood_1) + var(unit_cost_stone_1)) * 1.0 * min(1, max(0, var(vil_want_last))) + var(n_barracks) * var(barracks_spend) + var(n_redoubts) * var(redoubt_spend)"}, {"action": "set_var", "name": "income_proj", "value": "var(vils) * var(rate)"}, {"action": "set_var", "name": "bank_rate", "value": "max(0, food + wood + stone - var(unit_cost_food_1) - var(building_cost_wood_2)) / 15"}, {"action": "set_var", "name": "spare", "value": "var(income_proj) + var(bank_rate) - var(committed)"}, {"action": "set_var", "name": "shareH", "value": "var(vH) / (var(vH) + max(var(vB), var(vP)))"}, {"action": "set_var", "name": "u_barracks", "value": "max(0, var(spare)) * (1 - var(shareH)) / max(1, var(barracks_spend))"}, {"action": "set_var", "name": "u_redoubt", "value": "max(0, var(spare)) * var(shareH) / max(1, var(redoubt_spend))"}, {"action": "set_var", "name": "bar_barracks", "value": "(var(building_cost_food_22) + var(building_cost_wood_22) + var(building_cost_stone_22) + var(building_cost_gold_22)) / max(1, var(barracks_spend) * 15)"}, {"action": "set_var", "name": "bar_redoubt", "value": "(var(building_cost_food_23) + var(building_cost_wood_23) + var(building_cost_stone_23) + var(building_cost_gold_23)) / max(1, var(redoubt_spend) * 15)"}, {"action": "set_var", "name": "gold_income", "value": "2 * land"}, {"action": "set_var", "name": "redoubt_gold_ok", "value": "min(1, max(0, (var(gold_income) + max(0, gold) / 15) / max(1, var(unit_cost_gold_13) * 0.25) - var(n_redoubts)))"}, {"action": "set_var", "name": "barracks_want", "value": "min(1, max(0, var(vils))) * min(1, max(0, (var(u_barracks) - var(bar_barracks)) * 100))"}, {"action": "set_var", "name": "redoubt_want", "value": "min(1, max(0, var(vils))) * var(redoubt_gold_ok) * min(1, max(0, (var(u_redoubt) - var(bar_redoubt)) * 100))"}, {"action": "set_var", "name": "barracks_save", "value": "min(1, max(0, var(vils))) * min(1, max(0, (var(u_barracks) / max(0.01, var(bar_barracks)) - 0.7) * 3.4))"}, {"action": "set_var", "name": "redoubt_save", "value": "min(1, max(0, var(vils))) * var(redoubt_gold_ok) * min(1, max(0, (var(u_redoubt) / max(0.01, var(bar_redoubt)) - 0.7) * 3.4))"}, {"action": "set_var", "name": "army_target", "value": "var(population_max) * (1 - 0.5)"}, {"action": "set_var", "name": "unit_spend", "value": "max((var(unit_cost_food_11) + var(unit_cost_wood_11) + var(unit_cost_stone_11)), (var(unit_cost_food_12) + var(unit_cost_wood_12) + var(unit_cost_stone_12)), (var(unit_cost_food_13) + var(unit_cost_wood_13) + var(unit_cost_stone_13)))"}, {"action": "set_var", "name": "target_spend", "value": "var(army_target) / 15 * var(unit_spend) + var(vcs) * (var(unit_cost_food_1) + var(unit_cost_wood_1) + var(unit_cost_stone_1)) * 1.0"}, {"action": "set_var", "name": "vil_goal", "value": "min(var(population_max) * 0.5, max(0, var(target_spend) - var(bank_rate)) / var(rate) +