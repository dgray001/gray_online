_food", "value": "var(w_food) + var(spare) * var(spare_food)"}, {"action": "set_var", "name": "w_wood", "value": "var(w_wood) + var(spare) * (1 - var(spare_food))"}, {"action": "empty_bucket", "bucket": "food"}, {"action": "empty_bucket", "bucket": "wood"}, {"action": "empty_bucket", "bucket": "stone"}, {"action": "empty_bucket", "bucket": "gold"}, {"action": "set_bucket", "bucket": "food", "size": "max(0, var(w_food) - 0)", "task": {"action": "gather", "category": "food", "eligible": ["gather"]}}, {"action": "set_bucket", "bucket": "wood", "size": "max(0, var(w_wood) - 0.49)", "task": {"action": "gather", "category": "wood", "eligible": ["gather"]}}, {"action": "set_bucket", "bucket": "stone", "size": "max(0, var(w_stone) - 0.49)", "task": {"action": "gather", "category": "stone", "eligible": ["gather"]}}, {"action": "set_bucket", "bucket": "gold", "size": "max(0, var(w_gold) - 0.49)", "task": {"action": "gather", "category": "gold", "eligible": ["gather"]}}, {"action": "fill_bucket", "bucket": "food", "eligible": ["gather"], "unit_types": ["economic"]}, {"action": "fill_bucket", "bucket": "stone", "eligible": ["gather"], "unit_types": ["economic"]}, {"action": "fill_bucket", "bucket": "gold", "eligible": ["gather"], "unit_types": ["economic"]}, {"action": "fill_bucket", "bucket": "wood", "eligible": ["gather"], "unit_types": ["economic"]}]},
    {"when": {"always": {}}, "then": [{"action": "set_var", "name": "threat_home", "value": "var(enemy_units_visible_infantry_within_1)"}, {"action": "set_var", "name": "guard_home", "value": "var(population_infantry_within_1)"}]},
    {"when": {"all": [{"value_at_least": {"value": "var(threat_home)", "amount": 3}}, {"value_at_least": {"value": "var(threat_home) - var(guard_home)", "amount": 1}}]}, "then": [{"action": "garrison", "unit_types": ["economic"], "eligible": ["gather", "build", "move", "repair", "renew"]}]},
    {"when": {"value_at_most": {"value": "var(threat_home)", "amount": 0}}, "then": [{"action": "ungarrison", "unit_types": ["economic"]}]},
    {"when": {"all": [{"value_at_least": {"value": "var(vils)", "amount": 8}}, {"value_at_most": {"value": "var(farming)", "amount": 0}}]}, "then": [{"action": "research", "tech_id": 1, "queue": 2}]},
