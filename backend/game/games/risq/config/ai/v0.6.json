    {"when": {"always": {}}, "then": [{"action": "set_var", "name": "food_rate", "value": "var(vil_rate) * var(unit_cost_food_1) * 1.0 + var(barracks_B) * var(unit_cost_food_11) * 1.0 + var(barracks_P) * var(unit_cost_food_12) * 0.71 + var(redoubt_H) * var(unit_cost_food_13) * 0.25"}, {"action": "set_var", "name": "wood_rate", "value": "var(vil_rate) * var(unit_cost_wood_1) * 1.0 + var(barracks_B) * var(unit_cost_wood_11) * 1.0 + var(barracks_P) * var(unit_cost_wood_12) * 0.71 + var(redoubt_H) * var(unit_cost_wood_13) * 0.25"}, {"action": "set_var", "name": "stone_rate", "value": "var(vil_rate) * var(unit_cost_stone_1) * 1.0 + var(barracks_B) * var(unit_cost_stone_11) * 1.0 + var(barracks_P) * var(unit_cost_stone_12) * 0.71 + var(redoubt_H) * var(unit_cost_stone_13) * 0.25"}, {"action": "set_var", "name": "gold_rate", "value": "var(vil_rate) * var(unit_cost_gold_1) * 1.0 + var(barracks_B) * var(unit_cost_gold_11) * 1.0 + var(barracks_P) * var(unit_cost_gold_12) * 0.71 + var(redoubt_H) * var(unit_cost_gold_13) * 0.25"}, {"action": "set_var", "name": "tech_food", "value": "(1 - var(farming)) * var(tech_cost_food_1) + min(1, max(0, var(smiths) + var(smith_want))) * ((1 - var(pikes)) * var(tech_cost_food_5) + (1 - var(tech_researched_2)) * var(tech_cost_food_2) + (1 - var(tech_researched_3)) * var(tech_cost_food_3))"}, {"action": "set_var", "name": "tech_wood", "value": "(1 - var(farming)) * var(tech_cost_wood_1) + min(1, max(0, var(smiths) + var(smith_want))) * ((1 - var(pikes)) * var(tech_cost_wood_5) + (1 - var(tech_researched_2)) * var(tech_cost_wood_2) + (1 - var(tech_researched_3)) * var(tech_cost_wood_3))"}, {"action": "set_var", "name": "tech_stone", "value": "(1 - var(farming)) * var(tech_cost_stone_1) + min(1, max(0, var(smiths) + var(smith_want))) * ((1 - var(pikes)) * var(tech_cost_stone_5) + (1 - var(tech_researched_2)) * var(tech_cost_stone_2) + (1 - var(tech_researched_3)) * var(tech_cost_stone_3))"}, {"action": "set_var", "name": "tech_gold", "value": "(1 - var(farming)) * var(tech_cost_gold_1) + min(1, max(0, var(smiths) + var(smith_want))) * ((1 - var(pikes)) * var(tech_cost_gold_5) + (1 - var(tech_researched_2)) * var(tech_cost_gold_2) + (1 - var(tech_researched_3)) * var(tech_cost_gold_3))"}, {"action": "set_var", "name": "outpost_want", "value": "max(0, (var(gold_rate) + var(tech_gold) / 10 - var(gold_income)) / 2)"}, {"action": "set_var", "name": "lump_food", "value": "var(vc_want) * var(building_cost_food_1) + var(barracks_save) * var(building_cost_food_22) + var(redoubt_save) * var(building_cost_food_23) + var(smith_want) * var(building_cost_food_11) + var(farm_want) * var(building_cost_food_3) + min(1, var(outpost_want)) * var(building_cost_food_21) + var(house_want) * var(building_cost_food_2) * (1 + (10 - 1) * var(house_urgency))"}, {"action": "set_var", "name": "lump_wood", "value": "var(vc_want) * var(building_cost_wood_1) + var(barracks_save) * var(building_cost_wood_22) + var(redoubt_save) * var(building_cost_wood_23) + var(smith_want) * var(building_cost_wood_11) + var(farm_want) * var(building_cost_wood_3) + min(1, var(outpost_want)) * var(building_cost_wood_21) + var(house_want) * var(building_cost_wood_2) * (1 + (10 - 1) * var(house_urgency)) + var(building_count_3_depleted) * 60"}, {"action": "set_var", "name": "lump_stone", "value": "var(vc_want) * var(building_cost_stone_1) + var(barracks_save) * var(building_cost_stone_22) + var(redoubt_save) * var(building_cost_stone_23) + var(smith_want) * var(building_cost_stone_11) + var(farm_want) * var(building_cost_stone_3) + min(1, var(outpost_want)) * var(building_cost_stone_21) + var(house_want) * var(building_cost_stone_2) * (1 + (10 - 1) * var(house_urgency))"}, {"action": "set_var", "name": "lump_gold", "value": "var(vc_want) * var(building_cost_gold_1) + var(barracks_save) * var(building_cost_gold_22) + var(redoubt_save) * var(building_cost_gold_23) + var(smith_want) * var(building_cost_gold_11) + var(farm_want) * var(building_cost_gold_3) + min