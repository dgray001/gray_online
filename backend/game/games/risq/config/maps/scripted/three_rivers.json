[
  { "step": "shape", "params": { "kind": "triangle" } },
  { "step": "include", "params": { "path": "common/biomes.json" } },
  { "step": "include", "params": { "path": "common/land_details.json" } },
  { "step": "include", "params": { "path": "common/forests.json" } },
  { "step": "define", "params": { "name": "tri_offset", "value": "round(edge_length / 3)" } },
  { "step": "define", "params": { "name": "tri_mid", "value": "round((edge_length - 2 * tri_offset) / 2)" } },
  { "step": "define", "params": { "name": "tri_start_o", "value": "round(tri_offset / 3)" } },
  { "step": "define", "params": { "name": "tri_start_m", "value": "round(tri_mid / 3)" } },
  { "step": "define", "params": { "name": "tri_ford_o", "value": "round(2 * tri_offset / 3)" } },
  { "step": "define", "params": { "name": "tri_ford_m", "value": "round(2 * tri_mid / 3)" } },
  { "step": "terrain_blob", "params": { "terrain_id": "water", "seed_region": "line", "placement": { "points": [{ "x": "tri_start_m", "y": "-tri_start_o" }, { "x": "tri_mid", "y": "-tri_offset" }, { "x": "-tri_start_o", "y": "tri_start_m" }, { "x": "-tri_offset", "y": "tri_mid" }, { "x": "tri_start_m", "y": "tri_start_m" }, { "x": "tri_mid", "y": "tri_mid" }] } } },
  { "step": "terrain_blob", "params": { "terrain_type": "shallows", "size": 1, "placement": { "pattern": "points", "points": [{ "x": "tri_ford_m", "y": "-tri_ford_o" }, { "x": "-tri_ford_o", "y": "tri_ford_m" }, { "x": "tri_ford_m", "y": "tri_ford_m" }] } } },
  {
    "step": "player_starts",
    "params": {
      "pattern": "triangle", "area_size": 1,
      "inset": "1 + min(1, max(0, map_size - map_size_huge + 1))",
      "tree_ids": ["tree_a", "tree_b"], "terrain_id": "base"
    }
  },
  { "step": "define", "params": { "name": "region_corner_gold", "value": "5 * round(4 * total_spaces / 4 / 5)" } },
  { "step": "regions_four", "params": { "outer_bonus": "region_corner_gold", "center_bonus": "2 * region_corner_gold" } },
  { "step": "include", "params": { "path": "common/resources.json" } }
]
