[
  { "step": "shape", "params": { "kind": "triangle" } },
  { "step": "include", "params": { "path": "common/biomes.json" } },
  { "step": "define", "params": { "name": "tri_offset", "value": "round(edge_length / 3)" } },
  { "step": "define", "params": { "name": "tri_width", "value": "edge_length - 2 * tri_offset" } },
  { "step": "define", "params": { "name": "tri_mid", "value": "round(tri_width / 2)" } },
  { "step": "define", "params": { "name": "river_end", "value": "randomInt(ceil(tri_width / 2 - 1), floor(tri_width / 2 + 1))" } },
  { "step": "define", "params": { "name": "river_inner", "value": "randomInt(0, 1)" } },
  { "step": "terrain_blob", "params": { "terrain_id": "shallows", "seed_count": 1, "size": 7, "roundness": 1, "placement": { "pattern": "points", "points": [{ "x": 0, "y": 0 }] } } },
  {
    "step": "if",
    "params": {
      "condition": "map_size - 3",
      "then": [
        { "step": "terrain_blob", "params": { "terrain_id": "water", "seed_region": "line", "region": "river", "filter_seeds": true, "on": { "terrain_types": ["flatlands"] }, "placement": { "points": [{ "x": "river_inner", "y": -1 }, { "x": "river_end", "y": "-tri_offset" }] } } }
      ],
      "else": [
        { "step": "terrain_blob", "params": { "terrain_id": "water", "seed_region": "line", "region": "river", "placement": { "points": [{ "x": "river_inner", "y": -1 }, { "x": "river_end", "y": "-tri_offset" }] } } }
      ]
    }
  },
  { "step": "rotate", "params": { "count": 3, "region": "river" } },
  { "step": "define", "params": { "name": "accent_multiplier", "value": "1 + 0.15 * max(0, map_resources - 2)" } },
  { "step": "terrain_fill", "params": { "terrain_id": "base", "on": { "terrain_types": ["flatlands"] } } },
  { "step": "terrain_blob", "params": { "terrain_id": "accent1", "seed_count": "scale * 2 * accent_multiplier", "size": 4, "roundness": 0.92, "placement": { "evenness": 0.75 }, "preferred_spacing": 6, "min_spacing": 3, "on": { "terrain_types": ["flatlands"] } } },
  { "step": "terrain_blob", "params": { "variant": "hilly", "seed_count": "hill_seeds", "size": [3, 4], "roundness": 0.9, "placement": { "evenness": 0.9 }, "preferred_spacing": 5, "min_spacing": 3, "on": { "terrain_types": ["flatlands"] } } },
  { "step": "terrain_blob", "params": { "variant": "mountainous", "seed_count": "mountain_seeds", "size": 1, "placement": { "evenness": 0.95 }, "preferred_spacing": 7, "min_spacing": 4, "on": { "terrain_types": ["hilly"] } } },
  { "step": "include", "params": { "path": "common/forests.json" } },
  { "step": "resource_blob", "params": { "resource_weights": { "tree_a": 1, "tree_b": 1 }, "seed_count": 1, "size": 2, "on": { "terrain_types": ["shallows"] } } },
  { "step": "define", "params": { "name": "cnt0", "value": "round((num_players + 1) / 3)" } },
  { "step": "define", "params": { "name": "cnt1", "value": "round(num_players / 3)" } },
  { "step": "define", "params": { "name": "cnt2", "value": "round((num_players - 1) / 3)" } },
  { "step": "define", "params": { "name": "reg_rows", "value": "ceil(edge_length / 2)" } },
  { "step": "define", "params": { "name": "reg_last", "value": "reg_rows - 1" } },
  { "step": "define", "params": { "name": "reg_third", "value": "floor(reg_last / 3)" } },
  { "step": "define", "params": { "name": "reg_rem", "value": "reg_last - 3 * reg_third" } },
  { "step": "define", "params": { "name": "tie", "value": "randomInt(0, 2)" } },
  { "step": "define", "params": { "name": "tie_eff", "value": "tie * min(1, reg_rem)" } },
  { "step": "define", "params": { "name": "tie_one", "value": "max(0, 1 - (tie_eff - 1) * (tie_eff - 1))" } },
  { "step": "define", "params": { "name": "tie_two", "value": "max(0, 1 - (tie_eff - 2) * (tie_eff - 2))" } },
  { "step": "define", "params": { "name": "rem_two", "value": "max(0, min(1, reg_rem - 1))" } },
  { "step": "define", "params": { "name": "single_x", "value": "reg_third + (1 - rem_two) * tie_one + rem_two * (1 - tie_two)" } },
  { "step": "define", "params": { "name": "single_y", "value": "reg_third + (1 - rem_two) * tie_two + rem_two * (1 - tie_one)" } },
  { "step": "define", "params": { "name": "pair_sum", "value": "floor(reg_rows / 2) + 1" } },
  { "step": "define", "params": { "name": "pair_gap", "value": "4 - (pair_sum - 2 * floor(pair_sum / 2))" } },
  { "step": "define", "params": { "name": "pair_in", "value": "min(2, floor((pair_sum - pair_gap) / 2))" } },
  { "step": "define", "params": { "name": "back", "value": "randomInt(0, 1)" } },
  { "step": "define", "params": { "name": "reg_odd", "value": "reg_rows - 2 * floor(reg_rows / 2)" } },
  { "step": "define", "params": { "name": "last_x", "value": "reg_odd * reg_last / 2 + (1 - reg_odd) * (reg_rows / 2 - 1 + back)" } },
  { "step": "define", "params": { "name": "sym", "value": "randomInt(0, 5)" } },
  { "step": "define", "params": { "name": "sym_xq", "value": "max(0, 1 - sym * sym) + max(0, 1 - (sym - 4) * (sym - 4))" } },
  { "step": "define", "params": { "name": "sym_xr", "value": "max(0, 1 - (sym - 1) * (sym - 1)) + max(0, 1 - (sym - 3) * (sym - 3))" } },
  { "step": "define", "params": { "name": "sym_xs", "value": "max(0, 1 - (sym - 2) * (sym - 2)) + max(0, 1 - (sym - 5) * (sym - 5))" } },
  { "step": "define", "params": { "name": "sym_yr", "value": "max(0, 1 - sym * sym) + max(0, 1 - (sym - 5) * (sym - 5))" } },
  { "step": "define", "params": { "name": "sym_yq", "value": "max(0, 1 - (sym - 2) * (sym - 2)) + max(0, 1 - (sym - 3) * (sym - 3))" } },
  { "step": "define", "params": { "name": "sym_ys", "value": "max(0, 1 - (sym - 1) * (sym - 1)) + max(0, 1 - (sym - 4) * (sym - 4))" } },
  { "step": "if", "params": { "condition": "max(0, 1 - (cnt0 - 1) * (cnt0 - 1))", "then": [{ "step": "define", "params": { "name": "mark_c", "value": 0 } }, { "step": "define", "params": { "name": "mark_u", "value": "single_x" } }, { "step": "define", "params": { "name": "mark_v", "value": "single_y" } }, { "step": "include", "params": { "path": "common/three_rivers_marker.json" } }] } },
  { "step": "if", "params": { "condition": "max(0, 1 - (cnt1 - 1) * (cnt1 - 1))", "then": [{ "step": "define", "params": { "name": "mark_c", "value": 1 } }, { "step": "define", "params": { "name": "mark_u", "value": "single_x" } }, { "step": "define", "params": { "name": "mark_v", "value": "single_y" } }, { "step": "include", "params": { "path": "common/three_rivers_marker.json" } }] } },
  { "step": "if", "params": { "condition": "max(0, 1 - (cnt2 - 1) * (cnt2 - 1))", "then": [{ "step": "define", "params": { "name": "mark_c", "value": 2 } }, { "step": "define", "params": { "name": "mark_u", "value": "single_x" } }, { "step": "define", "params": { "name": "mark_v", "value": "single_y" } }, { "step": "include", "params": { "path": "common/three_rivers_marker.json" } }] } },
  { "step": "if", "params": { "condition": "cnt0 - 1", "then": [{ "step": "define", "params": { "name": "mark_c", "value": 0 } }, { "step": "define", "params": { "name": "mark_u", "value": "pair_in" } }, { "step": "define", "params": { "name": "mark_v", "value": "pair_sum - pair_in" } }, { "step": "include", "params": { "path": "common/three_rivers_marker.json" } }, { "step": "define", "params": { "name": "mark_u", "value": "pair_sum - pair_in" } }, { "step": "define", "params": { "name": "mark_v", "value": "pair_in" } }, { "step": "include", "params": { "path": "common/three_rivers_marker.json" } }] } },
  { "step": "if", "params": { "condition": "cnt1 - 1", "then": [{ "step": "define", "params": { "name": "mark_c", "value": 1 } }, { "step": "define", "params": { "name": "mark_u", "value": "pair_in" } }, { "step": "define", "params": { "name": "mark_v", "value": "pair_sum - pair_in" } }, { "step": "include", "params": { "path": "common/three_rivers_marker.json" } }, { "step": "define", "params": { "name": "mark_u", "value": "pair_sum - pair_in" } }, { "step": "define", "params": { "name": "mark_v", "value": "pair_in" } }, { "step": "include", "params": { "path": "common/three_rivers_marker.json" } }] } },
  { "step": "if", "params": { "condition": "cnt2 - 1", "then": [{ "step": "define", "params": { "name": "mark_c", "value": 2 } }, { "step": "define", "params": { "name": "mark_u", "value": "pair_in" } }, { "step": "define", "params": { "name": "mark_v", "value": "pair_sum - pair_in" } }, { "step": "include", "params": { "path": "common/three_rivers_marker.json" } }, { "step": "define", "params": { "name": "mark_u", "value": "pair_sum - pair_in" } }, { "step": "define", "params": { "name": "mark_v", "value": "pair_in" } }, { "step": "include", "params": { "path": "common/three_rivers_marker.json" } }] } },
  { "step": "if", "params": { "condition": "cnt0 - 2", "then": [{ "step": "define", "params": { "name": "mark_c", "value": 0 } }, { "step": "define", "params": { "name": "mark_u", "value": 1 } }, { "step": "define", "params": { "name": "mark_v", "value": 1 } }, { "step": "include", "params": { "path": "common/three_rivers_marker.json" } }] } },
  { "step": "if", "params": { "condition": "cnt1 - 2", "then": [{ "step": "define", "params": { "name": "mark_c", "value": 1 } }, { "step": "define", "params": { "name": "mark_u", "value": 1 } }, { "step": "define", "params": { "name": "mark_v", "value": 1 } }, { "step": "include", "params": { "path": "common/three_rivers_marker.json" } }] } },
  { "step": "if", "params": { "condition": "cnt2 - 2", "then": [{ "step": "define", "params": { "name": "mark_c", "value": 2 } }, { "step": "define", "params": { "name": "mark_u", "value": 1 } }, { "step": "define", "params": { "name": "mark_v", "value": 1 } }, { "step": "include", "params": { "path": "common/three_rivers_marker.json" } }] } },
  { "step": "if", "params": { "condition": "cnt0 - 3", "then": [{ "step": "define", "params": { "name": "mark_c", "value": 0 } }, { "step": "define", "params": { "name": "mark_u", "value": "last_x" } }, { "step": "define", "params": { "name": "mark_v", "value": "reg_last - last_x" } }, { "step": "include", "params": { "path": "common/three_rivers_marker.json" } }] } },
  { "step": "if", "params": { "condition": "cnt1 - 3", "then": [{ "step": "define", "params": { "name": "mark_c", "value": 1 } }, { "step": "define", "params": { "name": "mark_u", "value": "last_x" } }, { "step": "define", "params": { "name": "mark_v", "value": "reg_last - last_x" } }, { "step": "include", "params": { "path": "common/three_rivers_marker.json" } }] } },
  { "step": "if", "params": { "condition": "cnt2 - 3", "then": [{ "step": "define", "params": { "name": "mark_c", "value": 2 } }, { "step": "define", "params": { "name": "mark_u", "value": "last_x" } }, { "step": "define", "params": { "name": "mark_v", "value": "reg_last - last_x" } }, { "step": "include", "params": { "path": "common/three_rivers_marker.json" } }] } },
  {
    "step": "player_starts",
    "params": {
      "pattern": "triangle", "area_size": 1,
      "on": { "terrain_types": ["flatlands", "hilly", "mountainous", "swamp", "shallows"], "distance_to": { "target": { "terrain_ids": [26] }, "min": 0, "max": 0 } },
      "inset": 1,
      "tree_ids": ["tree_a", "tree_b"], "terrain_id": "base"
    }
  },
  { "step": "terrain_fill", "params": { "terrain_id": "base", "on": { "terrain_ids": [26] } } },
  { "step": "define", "params": { "name": "region_corner_gold", "value": "5 * round(4 * total_spaces / 4 / 5)" } },
  { "step": "regions_four", "params": { "outer_bonus": "region_corner_gold", "center_bonus": "2 * region_corner_gold", "center_space_gold": 4 } },
  { "step": "terrain_fill", "params": { "terrain_id": "shallows", "space_gold": 8, "on": { "terrain_types": ["shallows"] } } },
  { "step": "include", "params": { "path": "common/resources.json" } }
]
