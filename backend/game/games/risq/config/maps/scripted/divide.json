[
  { "step": "shape", "params": { "kind": "rectangle" } },
  { "step": "include", "params": { "path": "common/biomes.json" } },
  { "step": "define", "params": { "name": "mountain_seeds", "value": 0 } },
  { "step": "include", "params": { "path": "common/land_details.json" } },
  { "step": "define", "params": { "name": "forest_seeds", "value": "round(1.35 * forest_seeds)" } },
  { "step": "define", "params": { "name": "forest_seeds_base", "value": "round(1.35 * forest_seeds_base)" } },
  { "step": "include", "params": { "path": "common/forests.json" } },
  { "step": "define", "params": { "name": "spine_top_y", "value": "-round((rows - 1) / 2)" } },
  { "step": "define", "params": { "name": "spine_bot_y", "value": "rows - 1 + spine_top_y" } },
  { "step": "define", "params": { "name": "spine_top_x", "value": "round(-spine_top_y / 2)" } },
  { "step": "define", "params": { "name": "spine_bot_x", "value": "-round((spine_bot_y - 1) / 2)" } },
  { "step": "define", "params": { "name": "spine_flat", "value": "base" } },
  { "step": "if", "params": { "condition": "max(0, 1 - (biome - 4) * (biome - 4)) + max(0, 1 - (biome - 5) * (biome - 5))", "then": [{ "step": "define", "params": { "name": "spine_flat", "value": "accent1" } }] } },
  { "step": "terrain_blob", "params": { "terrain_id": "spine_flat", "seed_region": "line", "region": "mountain_range", "placement": { "points": [{ "x": "spine_top_x", "y": "spine_top_y" }, { "x": "spine_bot_x", "y": "spine_bot_y" }] } } },
  { "step": "terrain_blob", "params": { "variant": "hilly", "seed_region": "line", "region": "mountain_range", "size": "round(rows * 1.5)", "roundness": 0.3, "placement": { "points": [{ "x": "spine_top_x", "y": "spine_top_y" }, { "x": "spine_bot_x", "y": "spine_bot_y" }] } } },
  { "step": "terrain_blob", "params": { "variant": "mountainous", "seed_region": "line", "region": "mountain_range", "placement": { "points": [{ "x": "spine_top_x", "y": "spine_top_y" }, { "x": "spine_bot_x", "y": "spine_bot_y" }] } } },
  {
    "step": "player_starts",
    "params": {
      "pattern": "rows",
      "on": {
        "terrain_types": ["flatlands", "hilly", "swamp", "shallows"],
        "distance_to": { "target": { "terrain_types": ["mountainous"] }, "min": 2 }
      },
      "area_size": 1,
      "starting_distance": "rows / 2",
      "tree_ids": ["tree_a", "tree_b"],
      "terrain_id": "base"
    }
  },
  { "step": "define", "params": { "name": "region_outer_gold", "value": "5 * round(4 * total_spaces / 6 / 5)" } },
  { "step": "regions_six", "params": { "outer_bonus": "region_outer_gold", "center_bonus": "5 * round(2.5 * region_outer_gold / 5)" } },
  { "step": "define", "params": { "name": "outside_resource_multiplier", "value": "0.5 * min(map_resources, 2) + max(0, map_resources - 2) + max(0, map_resources - 3)" } },
  { "step": "resource_place", "params": { "resource_id": 1, "count": "outside_resource_multiplier * scale * 3 / 2", "clump_size": 2, "preferred_spacing": 7, "min_spacing": 3, "evenness": 0.9, "on": { "terrain_ids": ["accent1"] }, "outside_player_areas": true } },
  { "step": "resource_place", "params": { "resource_id": 2, "count": "outside_resource_multiplier * scale * 3 / 2", "clump_size": 2, "preferred_spacing": 7, "min_spacing": 3, "evenness": 0.9, "on": { "terrain_ids": ["base"] }, "outside_player_areas": true } },
  { "step": "resource_place", "params": { "resource_id": 41, "count": "round(1.3 * num_players * outside_resource_multiplier)", "on": { "terrain_types": ["mountainous"], "distance_to": { "region": "mountain_range", "distance": 0 } }, "outside_player_areas": true } },
  { "step": "resource_place", "params": { "resource_id": 42, "count": "round(1.3 * num_players * outside_resource_multiplier)", "on": { "terrain_types": ["mountainous"], "distance_to": { "region": "mountain_range", "distance": 0 } }, "outside_player_areas": true } },
  { "step": "resource_place", "params": { "resource_id": 43, "count": "round(1.3 * round(num_players / 2) * outside_resource_multiplier)", "on": { "terrain_types": ["mountainous"], "distance_to": { "region": "mountain_range", "distance": 0 } }, "outside_player_areas": true } }
]
